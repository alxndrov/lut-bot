# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Твой Telegram user_id (можно узнать у @userinfobot)
# Несколько через запятую: 123456789,987654321
ADMIN_IDS=123456789

# Prodamus
# Ссылка на магазин (из настроек Prodamus)
PRODAMUS_SHOP_URL=https://baryshovv.payform.ru
# Секретный ключ для проверки подписи вебхуков
PRODAMUS_SECRET=your_secret_key_here
# Порт для приёма вебхуков от Prodamus (по умолчанию 8080)
# PRODAMUS_WEBHOOK_PORT=8080
# Публичный адрес этого сервера для приёма webhook об оплате.
# Передаётся в ссылке оплаты (urlNotification), поэтому не зависит от настроек
# кабинета Prodamus. При переезде на другой сервер меняется только эта строка.
PRODAMUS_WEBHOOK_URL=http://YOUR_SERVER_IP:8080/prodamus/webhook

# --- Отдельный магазин Prodamus для ФИЗИЧЕСКИХ товаров ---
# Если не задать — физические товары идут через основной магазин выше.
# В кабинете физического магазина URL уведомлений: .../prodamus/webhook/physical
# PRODAMUS_SHOP_URL_PHYSICAL=https://your-physical-shop.payform.ru
# PRODAMUS_SECRET_PHYSICAL=physical_shop_secret
# PRODAMUS_WEBHOOK_URL_PHYSICAL=http://YOUR_SERVER_IP:8080/prodamus/webhook/physical

# Комиссия Prodamus в процентах (по умолчанию 3.5)
# PRODAMUS_FEE_PERCENT=3.5

# --- Доставка (СДЭК) ---
# Если не задать account и пароль — расчёт доставки выключен, адрес
# собирается свободным текстом (шаг «Текст шага доставки» в админке).
# CDEK_ACCOUNT=your_cdek_account
# CDEK_SECURE_PASSWORD=your_cdek_secure_password
# Город отправления (откуда считается тариф)
# CDEK_FROM_CITY=Москва
# true — песочница api.edu.cdek.ru (только тестовые аккаунты СДЭК)
# CDEK_TEST_MODE=false
# Доставка только до ПВЗ. 136 — склад-склад по договору «интернет-магазин».
# При обычном договоре заменить на 234.
# CDEK_TARIFF_PVZ=136
# Код ПВЗ СДЭК, куда вы сдаёте посылки (например, MSK16). Пока не задан,
# заказы в СДЭК не создаются — бот только считает доставку.
# CDEK_SHIPMENT_POINT=MSK16
# Вес (граммы) и габариты (см) посылки по умолчанию
# CDEK_PACKAGE_WEIGHT=500
# CDEK_PACKAGE_LENGTH=20
# CDEK_PACKAGE_WIDTH=15
# CDEK_PACKAGE_HEIGHT=5
# Что калькулятор СДЭК НЕ учитывает, а в счёт попадает: НДС и страховка
# («доп. сбор за объявленную стоимость», процент от цены товара).
# CDEK_VAT_PERCENT=7
# CDEK_INSURANCE_PERCENT=0.75
# Налог самозанятого — берётся со всей суммы платежа, включая доставку,
# поэтому цена доставки для клиента поднимается и на него тоже.
# NPD_PERCENT=4

# Формат наклейки ШК-места: A4, A5, A6 или A7.
# A6 (105×148 мм) — под рулон термоэтикеток 100×150 мм, A7 — под 75×100 мм.
# CDEK_BARCODE_FORMAT=A6

# Токен дополнительного бота для уведомлений администраторам о новых покупках
# Если не задан — уведомления не отправляются
# WAITLIST_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google Таблица с заказами ---
# ID из ссылки: docs.google.com/spreadsheets/d/<ЭТОТ_КУСОК>/edit
# Пока не задан — кнопка выгрузки в боте не показывается.
# GOOGLE_SHEET_ID=1AbC...
# Путь к JSON-ключу сервисного аккаунта Google
# GOOGLE_CREDENTIALS_FILE=google-service-account.json
# Название листа внутри таблицы
# GOOGLE_SHEET_TAB=Заказы
# Отдельный лист той же таблицы — финансовая книга по заказам (дата,
# номер, оплата, отложено на СДЭК — дописывается по заказу; остальные
# колонки формулами). Лист создаётся сам при первом заказе, если его нет.
# GOOGLE_SHEET_FINANCE_TAB=Финансы

# --- Согласие на обработку персональных данных ---
# Пока ссылка не задана, согласие не спрашивается.
# PRIVACY_POLICY_URL=https://drive.google.com/drive/folders/...
# Оферта — необязательно, кнопка появится только если задана
# OFFER_URL=https://...
