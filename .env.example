# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Твой Telegram user_id (можно узнать у @userinfobot)
# Несколько через запятую: 123456789,987654321
ADMIN_IDS=123456789

# Prodamus
# Ссылка на магазин (из настроек Prodamus)
PRODAMUS_SHOP_URL=https://baryshovv.payform.ru
# Секретный ключ для проверки подписи вебхуков
PRODAMUS_SECRET=your_secret_key_here
# Порт для приёма вебхуков от Prodamus (по умолчанию 8080)
# PRODAMUS_WEBHOOK_PORT=8080

# Комиссия Prodamus в процентах (по умолчанию 3.5)
# PRODAMUS_FEE_PERCENT=3.5

# Токен дополнительного бота для уведомлений администраторам о новых покупках
# Если не задан — уведомления не отправляются
# WAITLIST_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
