BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789

# Действующий договор СДЭК — для новых заказов.
CDEK_ACCOUNT=
CDEK_SECURE_PASSWORD=
# Прежний договор — отслеживание, наклейки и повторы старых заказов.
# При первом запуске поддержки двух договоров существующие заказы
# привязываются к OLD (или к действующему, если OLD не задан).
CDEK_ACCOUNT_OLD=
CDEK_SECURE_PASSWORD_OLD=

PRODAMUS_SHOP_URL=https://example.payform.ru/
PRODAMUS_SECRET=your_prodamus_secret
PRODAMUS_WEBHOOK_URL=https://example.com/prodamus/webhook
